# Smart Market backend configuration.
# Copy this file to `.env` and adjust values. Never commit real secrets.

# MySQL/MariaDB (production default). Adjust user/password/host/db to match your XAMPP setup.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/smartmarket

# Secret used to sign JWT access tokens (HS256). Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Trolley status is considered stale when the last update is older than this many seconds.
STALE_AFTER_SECONDS=60
