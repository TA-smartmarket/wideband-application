# Smart Market backend configuration (local demo).
# SQLite dipakai agar tidak butuh MySQL/MariaDB (XAMPP) untuk coba-coba.
# Untuk produksi/MySQL, ganti dengan:
#   mysql+pymysql://root:@127.0.0.1:3306/smartmarket
DATABASE_URL=sqlite:///./smartmarket.db

# Secret untuk JWT (demo lokal).
SECRET_KEY=local-dev-secret-change-me-0123456789abcdef

# Masa berlaku token (menit).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Status troli dianggap stale setelah N detik.
STALE_AFTER_SECONDS=60